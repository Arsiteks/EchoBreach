    object TabSheet1: TTabSheet
      Caption = 'Application'
      ClientHeight = 204
      ClientWidth = 506
      object Label1: TLabel
        Left = 5
        Height = 194
        Top = 5
        Width = 496
        Align = alClient
        BorderSpacing.Around = 5
        Caption = 'The Signal Cartel is an immersive, terminal-based acoustic hacking simulator. Intercept hidden audio frequencies, navigate procedurally generated networks, evade active counter-hacks, and dismantle a dangerous underground syndicate.'#13#10#13#10'The Signal Cartel is hiding their darkest secrets in plain sight—encrypted within acoustic carrier waves. As a freelance cyber-operator working alongside your handler [ZERO], you must utilize experimental audio-hacking tools to breach their network, steal their data, and expose their operations to the world.'
        WordWrap = True
      end
    end
    object TabSheet2: TTabSheet
      Caption = 'Project  Arsiteks '
      ClientHeight = 204
      ClientWidth = 506
      object Label2: TLabel
        Left = 5
        Height = 194
        Top = 5
        Width = 496
        Align = alClient
        BorderSpacing.Around = 5
        Caption = 'Arsiteks—a Company developer focused on designing and building 2D simulation games that explore various academic disciplines and aspects of life.'#13#10#13#10'In a landscape dominated by games designed purely for entertainment, my mission is to offer a meaningful alternative: making the learning process feel like play. Through interactive simulations, I transform complex concepts—ranging from science and engineering to the dynamics of everyday life—into visual experiences that are accessible, engaging, and relevant to today’s generation.'#13#10'All of my projects are developed using Lazarus IDE and Free Pascal (FPC). This choice of native technology is intentional: the resulting applications and simulation games offer high performance and a very small file size, and they run smoothly even on computers with limited hardware specifications—ensuring more equitable access to education, unhindered by hardware constraints.'
        WordWrap = True
      end
    end
  end
end
